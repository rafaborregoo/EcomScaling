{
  "name": "ecomscaling-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo EcomScaling IA",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "predev": "node scripts/ensure-redis.mjs",
    "dev": "concurrently -n api,web,worker -c blue,green,yellow \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:worker\"",
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=@ecomscaling/api",
    "dev:worker": "npm run dev --workspace=@ecomscaling/worker",
    "build": "npm run build:packages && npm run build -w @ecomscaling/api -w web -w @ecomscaling/worker",
    "build:packages": "npm run build -w @ecomscaling/ai -w @ecomscaling/config -w @ecomscaling/contracts -w @ecomscaling/db -w @ecomscaling/domain -w @ecomscaling/integrations -w @ecomscaling/observability",
    "typecheck": "npm run build:packages && npm run build -w @ecomscaling/api && npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:demo-user": "dotenv -e .env.local -- tsx scripts/seed-demo-user.ts",
    "seed:shopify-store": "dotenv -e .env.local -- tsx scripts/seed-shopify-store.ts",
    "seed:meta-history": "dotenv -e .env.local -- tsx scripts/seed-meta-history.ts",
    "seed:klaviyo-history": "dotenv -e .env.local -- tsx scripts/seed-klaviyo-history.ts",
    "db:push": "dotenv -e .env.local -- node scripts/db-push.mjs",
    "check:meta-metrics": "dotenv -e .env.local -- node scripts/check-meta-metrics.mjs",
    "supabase": "supabase",
    "supabase:init": "supabase init",
    "supabase:link": "supabase link --project-ref cthjwpeygpzwdmjkxeqa",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "dotenv-cli": "^11.0.0",
    "pg": "^8.23.0",
    "prettier": "^3.6.2",
    "supabase": "^2.31.8",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.109.0",
    "nanoid": "3.3.18",
    "ws": "^8.21.1"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
