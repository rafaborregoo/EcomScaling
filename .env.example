# EcomScaling — plantilla local segura. Nunca pongas valores reales en este archivo.
# Copia a .env.local y completa solo las variables del entorno que vas a usar.

APP_ENV=local
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase (obligatorio para la API y el frontend)
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Solo servidor/cron; nunca NEXT_PUBLIC_ ni frontend.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_JWT_SECRET=replace-with-jwt-secret
SUPABASE_DB_URL=postgresql://postgres:replace-with-password@db.your-project.supabase.co:5432/postgres
SUPABASE_DB_PASSWORD=replace-with-db-password

# Shopify público (obligatorio aunque se use otra integración)
SHOPIFY_API_KEY=replace-with-public-app-key
SHOPIFY_API_SECRET=replace-with-public-app-secret
SHOPIFY_SCOPES=read_products,read_inventory,read_locations,read_orders,read_customers
SHOPIFY_REDIRECT_URI=http://localhost:4000/v1/integrations/shopify/callback
SHOPIFY_API_VERSION=2026-07

# Shopify custom distribution (las cuatro juntas o ninguna)
# SHOPIFY_CUSTOM_API_KEY=replace-with-custom-app-key
# SHOPIFY_CUSTOM_API_SECRET=replace-with-custom-app-secret
# SHOPIFY_CUSTOM_SCOPES=read_products,read_inventory,read_locations,read_orders,read_customers
# SHOPIFY_CUSTOM_REDIRECT_URI=http://localhost:4000/v1/integrations/shopify/callback

# Meta Ads (las tres primeras juntas o ninguna; scopes/versiones son opcionales)
# META_APP_ID=replace-with-meta-app-id
# META_APP_SECRET=replace-with-meta-app-secret
# META_REDIRECT_URI=http://localhost:4000/v1/integrations/meta/callback
# META_GRAPH_VERSION=v23.0
# META_SCOPES=ads_read,business_management,pages_show_list
# META_INSIGHTS_MODE=sync
# META_ACTION_REPORT_TIME=impression

# Klaviyo OAuth (las tres primeras juntas o ninguna)
# KLAVIYO_CLIENT_ID=replace-with-klaviyo-client-id
# KLAVIYO_CLIENT_SECRET=replace-with-klaviyo-client-secret
# KLAVIYO_REDIRECT_URI=http://localhost:4000/v1/integrations/klaviyo/callback
# KLAVIYO_SCOPES=accounts:read flows:read campaigns:read forms:read lists:read segments:read metrics:read

# Otros conectores preparados
# FATHOM_API_KEY=replace-with-fathom-api-key
# FATHOM_WEBHOOK_SECRET=replace-with-fathom-webhook-secret

# IA (opcionales; sin claves la plataforma funciona con IA desactivada)
# ANTHROPIC_API_KEY=replace-with-anthropic-key
# OPENAI_API_KEY=replace-with-openai-key
# OPENAI_MODEL=replace-with-model-id
# VOYAGE_API_KEY=replace-with-voyage-key
# AI_ORCHESTRATION_MODE=direct
# AI_MODEL_ROUTING_JSON={}
# AI_PLAN_BUDGETS_JSON={}
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=replace-with-langsmith-key
# LANGSMITH_PROJECT=ecomscaling-local

# Runtime y operaciones
# INTEGRATION_FEATURE_FLAGS=shopify
# INTERNAL_API_SECRET=replace-with-internal-secret
# REDIS_URL=redis://localhost:6379
# SQO-02: URL publica de una API ya desplegada, para que el chequeo de salud
# operativa (cron) pueda leer /health/slo de esa instancia real. Sin esto (y
# sin INTERNAL_API_SECRET) el chequeo de SLO simplemente se omite.
# API_BASE_URL=https://api.tudominio.com
