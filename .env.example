# Shared
NODE_ENV=development

# Supabase frontend
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000

# Backend/worker only. Never expose in NEXT_PUBLIC_* variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DB_PASSWORD=

# API
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3001

# Worker / queue
REDIS_URL=redis://localhost:6379
API_URL=http://localhost:4000
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_analytics,read_channels,read_customers,read_price_rules,read_discounts,read_draft_orders,read_fulfillments,read_gift_card_transactions,read_inventory,read_locations,read_marketing_integrated_campaigns,read_marketing_events,read_markets,read_order_edits,read_orders,read_payment_terms,read_product_listings,read_products,read_publications,read_reports,read_returns,read_shopify_payments_accounts,read_shopify_payments_payouts,read_shopify_payments_disputes,read_store_credit_account_transactions
SHOPIFY_REDIRECT_URI=http://localhost:4000/v1/shopify/oauth/callback

# App Shopify de distribucion personalizada (custom distribution), para conectar tiendas
# reales de clientes mientras la app publica esta pendiente de revision de Shopify.
# Opcionales: si se dejan vacias, la opcion "app personalizada" no aparece en /integraciones.
# Deben estar las 4 seteadas juntas o ninguna.
SHOPIFY_CUSTOM_API_KEY=
SHOPIFY_CUSTOM_API_SECRET=
SHOPIFY_CUSTOM_SCOPES=
SHOPIFY_CUSTOM_REDIRECT_URI=

# App Meta (Marketing API), para conectar cuentas publicitarias de clientes.
# Opcionales: si se dejan vacias, el boton "Conectar Meta Ads" no aparece en /integraciones.
# META_APP_ID, META_APP_SECRET y META_REDIRECT_URI deben estar las 3 seteadas juntas o ninguna.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_SCOPES=ads_read,business_management,pages_show_list

# Runtime de agentes IA (AI-00). Opcional: sin key, los endpoints /ai devuelven 503.
# Crear en https://console.anthropic.com
ANTHROPIC_API_KEY=

# Embeddings para RAG (AI-04, decision: pgvector en Supabase + proveedor
# swappable). Opcional: sin key, la ingestion/busqueda de conocimiento devuelve
# 503 y la tool search_knowledge del agente no se habilita.
# Crear en https://dashboard.voyageai.com
VOYAGE_API_KEY=

# Internal service-to-service auth (api <-> worker). Generate with `openssl rand -hex 32`.
# Leave unset to disable the reconciliation cron entirely.
INTERNAL_API_SECRET=
