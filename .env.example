# Dos entornos, dos ficheros (Shopify exige separar test y produccion para el
# acceso a datos protegidos Nivel 2, ver docs/SHOPIFY_DATOS_PROTEGIDOS.md):
#
#   .env.local              desarrollo -> proyecto Supabase de desarrollo
#   .env.production.local   produccion  -> solo para `npm run db:push:prod`
#
# APP_ENV marca donde crees estar; SUPABASE_ENV_GUARD=block hace que la API y
# el worker se nieguen a arrancar si ese entorno apunta al Supabase real (sin
# el, solo avisan por consola).
# EcomScaling — plantilla local segura. Nunca pongas valores reales en este archivo.
# Copia a .env.local y completa solo las variables del entorno que vas a usar.

APP_ENV=local
# Pon "block" en desarrollo cuando el proyecto de Supabase de desarrollo exista.
SUPABASE_ENV_GUARD=warn
# Commit desplegado. Lo inyecta deploy/docker-compose.prod.yml desde IMAGE_TAG;
# en local se deja sin definir y agent_runs.deployment_version queda null.
# GIT_SHA=
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase (obligatorio para la API y el frontend)
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Solo servidor/cron; nunca NEXT_PUBLIC_ ni frontend.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_JWT_SECRET=replace-with-jwt-secret
SUPABASE_DB_URL=postgresql://postgres:replace-with-password@db.your-project.supabase.co:5432/postgres
SUPABASE_DB_PASSWORD=replace-with-db-password

# Shopify público (obligatorio aunque se use otra integración)
SHOPIFY_API_KEY=replace-with-public-app-key
SHOPIFY_API_SECRET=replace-with-public-app-secret
# `read_reports` lo pide el bloque `sessions` (sesiones y conversión vía
# ShopifyQL). Sin él ese bloque devuelve ACCESS_DENIED y la tienda se queda sin
# embudo. Añadirlo aquí hace que `listAccountActions` marque las conexiones ya
# autorizadas como "Shopify necesita reautorización", que es el camino previsto.
SHOPIFY_SCOPES=read_products,read_files,read_inventory,read_locations,read_orders,read_customers,read_discounts,read_marketing_events,read_reports
SHOPIFY_REDIRECT_URI=http://localhost:4000/v1/shopify/oauth/callback
SHOPIFY_API_VERSION=2026-07
# Public HTTPS webhook ingress (local: npm run dev:webhooks, then restart API/worker).
# INTEGRATION_WEBHOOK_BASE_URL=https://your-public-webhook-host.example.com
# Enable only for Klaviyo Advanced KDP / approved partner accounts with webhook scopes.
KLAVIYO_SYSTEM_WEBHOOKS_ENABLED=false

# Shopify custom distribution (las cuatro juntas o ninguna)
# SHOPIFY_CUSTOM_API_KEY=replace-with-custom-app-key
# SHOPIFY_CUSTOM_API_SECRET=replace-with-custom-app-secret
# SHOPIFY_CUSTOM_SCOPES=read_products,read_inventory,read_locations,read_orders,read_customers,read_discounts,read_marketing_events,read_reports
# SHOPIFY_CUSTOM_REDIRECT_URI=http://localhost:4000/v1/shopify/oauth/callback

# Meta Ads (las tres primeras juntas o ninguna; scopes/versiones son opcionales)
# META_APP_ID=replace-with-meta-app-id
# META_APP_SECRET=replace-with-meta-app-secret
# META_REDIRECT_URI=http://localhost:4000/v1/meta/oauth/callback
# META_GRAPH_VERSION=v23.0
# META_SCOPES=ads_read,ads_management,business_management,pages_show_list
# Facebook Login for Business (app de tipo Business): id de la configuracion
# del panel (Inicio de sesion con Facebook for Business > Configuraciones). Si
# la configuracion es de tipo «Token de acceso de usuario del sistema», el token
# no caduca y el cliente no tiene que reconectar cada ~60 dias. Vacio = login
# clasico por scope, con token de usuario que caduca (se avisa 7 dias antes).
# META_LOGIN_CONFIG_ID=
# META_INSIGHTS_MODE=sync
# META_ACTION_REPORT_TIME=impression

# Klaviyo OAuth (las tres primeras juntas o ninguna)
# KLAVIYO_CLIENT_ID=replace-with-klaviyo-client-id
# KLAVIYO_CLIENT_SECRET=replace-with-klaviyo-client-secret
# KLAVIYO_REDIRECT_URI=http://localhost:4000/v1/klaviyo/oauth/callback
# KLAVIYO_SCOPES=accounts:read events:read flows:read campaigns:read forms:read lists:read segments:read metrics:read templates:read templates:write campaigns:write flows:write
# templates:write es lo que permite publicar plantillas desde /marketing. Al
# ampliar los scopes hay que reautorizar las conexiones OAuth ya existentes.

# Otros conectores preparados
# FATHOM_API_KEY=replace-with-fathom-api-key
# FATHOM_WEBHOOK_SECRET=replace-with-fathom-webhook-secret

# Stripe: la pasarela de cobro de la plataforma (ver docs/STRIPE.md).
# El secreto del webhook basta para que altas y bajas de plan lleguen solas;
# la clave secreta hace falta ademas para abrir un checkout y listar planes.
# Ojo: el whsec_ de Stripe se usa en TEXTO PLANO, no en base64 como el de
# Standard Webhooks (Fathom). Ver apps/api/src/stripe-webhook.ts.
# Usa una clave RESTRINGIDA (rk_) y no la secreta (sk_): esto solo necesita
# leer precios y facturas, y crear sesiones de checkout.
# STRIPE_SECRET_KEY=rk_test_replace-me
# STRIPE_WEBHOOK_SECRET=whsec_replace-with-stripe-webhook-secret
# STRIPE_API_VERSION=2026-08-26.dahlia
# Solo este precio habilita Managed Payments; los demás conservan el flujo actual.
# STRIPE_MANAGED_PAYMENTS_PRICE_ID=price_...

# VERI*FACTU (opcionales hasta activar la emision fiscal real).
# El PFX debe llegar como base64 y nunca se guarda en Supabase.
# VERIFACTU_CERT_PFX_BASE64=replace-with-base64-pfx
# VERIFACTU_CERT_PASSWORD=replace-with-pfx-password
# VERIFACTU_ENVIRONMENT=test

# IA (opcionales; sin claves la plataforma funciona con IA desactivada)
# ANTHROPIC_API_KEY=replace-with-anthropic-key
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_API_KEY / OPENAI_MODEL son el SEGUNDO PROVEEDOR (R-020). En produccion
# no son opcionales de verdad: sin ellas, cualquier fallo de Anthropic -- caida,
# rate limit o saldo agotado -- mata la ejecucion sin alternativa. La API avisa
# al arrancar y /health/ready lo marca como degradado.
# OPENAI_API_KEY=replace-with-openai-key
# OPENAI_MODEL=gpt-4.1
# VOYAGE_API_KEY=replace-with-voyage-key
# AI_MODEL_ROUTING_JSON={}
# AI_PLAN_BUDGETS_JSON={}
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=replace-with-langsmith-key
# LANGSMITH_PROJECT=ecomscaling-local

# Runtime y operaciones
# INTEGRATION_FEATURE_FLAGS=shopify
# INTERNAL_API_SECRET=replace-with-internal-secret
# Alertas por webhook compatible con Slack Incoming Webhooks o Discord.
# PLATFORM_ALERT_WEBHOOK_URL=
# Token aleatorio compartido con el monitor externo de disponibilidad.
# PLATFORM_MONITOR_TOKEN=replace-with-a-long-random-secret
# Token Supabase Management API con permiso backups_read; solo servidor.
# SUPABASE_ACCESS_TOKEN=replace-with-scoped-management-token
# ISO-8601 de la última restauración de backup verificada manualmente.
# SUPABASE_LAST_RESTORE_VERIFIED_AT=2026-09-01T12:00:00Z
# Clave del HMAC con el que se guardan los codigos de vinculacion de clientes.
# Obligatoria para EMITIR codigos nuevos: sin ella la API devuelve 503 en vez de
# guardar el codigo en claro, que es lo que esta migracion viene a quitar.
# Minimo 16 caracteres. Cambiarla invalida los codigos pendientes.
# INVITE_CODE_SECRET=replace-with-invite-code-secret
# REDIS_URL=redis://localhost:6379
# SQO-02: URL publica de una API ya desplegada, para que el chequeo de salud
# operativa (cron) pueda leer /health/slo de esa instancia real. Sin esto (y
# sin INTERNAL_API_SECRET) el chequeo de SLO simplemente se omite.
# API_BASE_URL=https://api.tudominio.com

# Agentes de IA: control de gasto.
# AI_AUTORUN_ENABLED=false apaga TODA ejecucion automatica (cron del
# orquestador + regeneracion al abrir una pagina). Los botones de "Ejecutar"
# siguen funcionando. Recomendado en desarrollo y en el VPS mientras no este en
# uso real. Sin la variable, el autorun sigue encendido.
AI_AUTORUN_ENABLED=true
# Topes de coste (opcionales; defaults: 50 USD/dia de plataforma, 12 runs/dia
# por organizacion).
# AI_PLATFORM_DAILY_COST_CAP_USD=50
# AI_ORG_DAILY_RUN_CAP=12
# Refrescos manuales ("Actualizar ahora") por organizacion y dia, sumando todos
# los agentes de diagnostico. Default 12 (~$1.8/dia por tienda en el peor caso).
# AI_MANUAL_REFRESH_DAILY_CAP=12

# ADR-0025: campaña de mailing orquestada con LangGraph (apagado por defecto).
# MAILING_GRAPH_ORGS limita el piloto a esas organizaciones (uuids separados por coma).
# MAILING_GRAPH_ENABLED=false
# MAILING_GRAPH_ORGS=
