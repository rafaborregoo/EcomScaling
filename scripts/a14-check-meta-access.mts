import assert from "node:assert/strict";
import { mkdir, writeFile } from "node:fs/promises";
import { createClient } from "@supabase/supabase-js";
import { loadApiEnv } from "@e-nora/config";
import { getValidMetaAccessToken } from "../apps/api/src/meta.js";
import { metaGraphGet, metaGraphGetAll, MetaGraphError } from "../apps/api/src/meta-client.js";
const env = loadApiEnv(process.env);
assert.equal(new URL(env.SUPABASE_URL).hostname, "kopcblejsxpkxoykldyh.supabase.co");
const db = createClient(env.SUPABASE_URL, env.SUPABASE_SERVICE_ROLE_KEY!, { auth: { persistSession: false } });
const connectionId = "bf821942-5756-4609-8180-23e83c36c9cb", orgId = "5ebc7b02-ca86-402e-bd61-9abd22f1ee04";
const { data: connection, error } = await db.from("integration_connections").select("id,status,updated_at,last_sync_at,last_error_at").eq("id", connectionId).eq("organization_id", orgId).eq("provider", "meta_ads").single();
assert.ifError(error); assert.ok(connection);
const token = await getValidMetaAccessToken(env, connectionId); assert.ok(token, "meta_access_token_unavailable");
const check = async (run: () => Promise<unknown>) => { try { return { ok: true, result: await run() }; } catch (error) { return { ok: false, code: error instanceof MetaGraphError ? error.code : null, message: error instanceof Error ? error.message : "request_failed" }; } };
const permissions = await check(async () => (await metaGraphGetAll<{ permission: string; status: string }>("me/permissions", token, {}, env.META_APP_SECRET)).map(({ permission, status }) => ({ permission, status })));
const targetAccount = process.argv.includes("--alternative") ? "act_1797270924877645" : "act_946548861093802";
const account = await check(() => metaGraphGet(targetAccount, token, { fields: "id,name,account_status" }, env.META_APP_SECRET));
const accessibleAccounts = await check(() => metaGraphGetAll("me/adaccounts", token, { fields: "id,name,account_status", limit: "100" }, env.META_APP_SECRET));
const insights = await check(async () => { const result = await metaGraphGet<{ data: unknown[] }>(`${targetAccount}/insights`, token, { fields: "impressions,spend", date_preset: "last_7d", limit: "1" }, env.META_APP_SECRET); return { rows: result.data.length }; });
const receipt = { checked_at: new Date().toISOString(), targetAccount, connection, permissions, account, accessibleAccounts, insights, read_only_meta_requests: true };
await mkdir(".e-nora-test-lab/a14-closeout-2026-11-05", { recursive: true });
await writeFile(`.e-nora-test-lab/a14-closeout-2026-11-05/meta-access${process.argv.includes("--alternative") ? "-alternative" : ""}.json`, JSON.stringify(receipt, null, 2));
console.log(JSON.stringify(receipt));
