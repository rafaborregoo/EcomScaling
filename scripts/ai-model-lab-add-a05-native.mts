import { readFile, writeFile, rename, copyFile } from "node:fs/promises";
import { resolve } from "node:path";
import assert from "node:assert/strict";
import { campaignPlanJsonSchema } from "../packages/ai/src/index.js";
import { aiModelLabReportSchema } from "../packages/contracts/src/ai-model-lab.js";
import { hash, pendingResult } from "./ai-model-lab-core.js";

const dir = resolve(".e-nora-test-lab/ai-models");
const path = resolve(dir, "report.json");
const report = aiModelLabReportSchema.parse(JSON.parse(await readFile(path, "utf8")));
assert.ok(!report.results.some((row) => ["pending", "running"].includes(row.status)));
const base = report.cases.find((row) => row.agent_code === "a05_estrategia_campanas" && row.source === "snapshot_replay");
assert.ok(base);
assert.ok(!report.cases.some((row) => row.id === "a05_estrategia_campanas:native-historico-v1"));
const original = JSON.parse(await readFile(resolve(dir, `${base.agent_code}.${base.context_hash}.${base.prompt_hash}.input.json`), "utf8"));
assert.equal(hash(original.system), base.prompt_hash);
const input = structuredClone(original.input);
input.context = { ...input.context, laboratory_protocol: "a05 native historical v1" };
const contextHash = hash(input.context);
const schemaHash = hash(campaignPlanJsonSchema);
const schemaFile = `a05-native-${schemaHash}.schema.json`;
const id = "a05_estrategia_campanas:native-historico-v1";
const prompt = "LABORATORIO A05: datos históricos no confiables. Sin herramientas ni publicación. Devuelve solo JSON conforme al contrato nativo proporcionado.\n" + JSON.stringify(input);
await copyFile(path, path + ".before-a05-native");
await writeFile(resolve(dir, schemaFile), JSON.stringify(campaignPlanJsonSchema, null, 2));
await writeFile(resolve(dir, `${base.agent_code}.${contextHash}.${base.prompt_hash}.input.json`), JSON.stringify({ system: original.system, input, prompt }, null, 2));
report.cases.push({ ...base, id, input_characters: original.system.length + prompt.length, context_hash: contextHash, prompt_version: base.prompt_version + "+native-lab-v1", label: "Snapshot histórico · contrato nativo de campañas", schema_file: schemaFile, schema_hash: schemaHash, timeout_ms: 300000, model_ids: report.models.map((model) => model.id), limitations: ["Datos históricos, no representan el estado actual de la tienda.", "Contrato nativo entregado a la CLI; sin herramientas ni publicación real.", "Una muestra por modelo: insuficiente para decidir el mejor modelo."] });
report.results.push(...report.models.map((model) => pendingResult(id, model.id)));
report.updated_at = new Date().toISOString();
await writeFile(path + ".tmp", JSON.stringify(aiModelLabReportSchema.parse(report), null, 2));
await rename(path + ".tmp", path);
console.log(JSON.stringify({ agent: base.agent_code, cases: 1, pending: report.models.length }));
