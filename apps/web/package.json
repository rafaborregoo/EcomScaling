{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env.local -- next dev --port 3001",
    "build": "npm run build -w @ecomscaling/contracts && next build",
    "build:local": "dotenv -e ../../.env.local -- next build",
    "start": "dotenv -e ../../.env.local -- next start --port 3001",
    "lint": "eslint",
    "test:intervention-eligibility": "tsx --test --test-force-exit src/app/shopify/diagnostico/intervention-eligibility-view-model.test.ts src/app/shopify/diagnostico/intervention-matching-view-model.test.ts src/app/shopify/diagnostico/intervention-prioritization-view-model.test.ts src/app/shopify/diagnostico/intervention-impact-view-model.test.ts src/app/shopify/diagnostico/intervention-feasibility-view-model.test.ts src/app/shopify/diagnostico/intervention-risk-view-model.test.ts src/app/shopify/diagnostico/intervention-sequencing-view-model.test.ts src/app/shopify/diagnostico/intervention-test-execute-view-model.test.ts src/app/shopify/diagnostico/intervention-intensity-view-model.test.ts src/app/shopify/diagnostico/maturity-recommendations-view-model.test.ts src/app/shopify/diagnostico/constraint-recommendations-view-model.test.ts src/app/shopify/diagnostico/recommendation-portfolio-view-model.test.ts src/app/shopify/diagnostico/dynamic-decision-view-model.test.ts src/app/shopify/diagnostico/restraint-decision-view-model.test.ts src/lib/insights-registry.test.ts",
    "test:expected-outcome": "tsx --test --test-force-exit src/app/shopify/diagnostico/expected-outcome-view-model.test.ts src/lib/insights-registry.test.ts",
    "test:recommendation-confidence": "tsx --test --test-force-exit src/app/shopify/diagnostico/recommendation-confidence-view-model.test.ts src/lib/insights-registry.test.ts",
    "test:recommendation-communication": "tsx --test --test-force-exit src/app/shopify/diagnostico/recommendation-communication-view-model.test.ts src/lib/insights-registry.test.ts",
    "test:continuous-learning": "tsx --test --test-force-exit src/app/shopify/diagnostico/continuous-learning-view-model.test.ts src/lib/insights-registry-f9.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-force-exit \"src/**/*.test.ts\""
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ecomscaling/contracts": "^0.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@heroui/react": "^3.2.2",
    "@supabase/supabase-js": "^2.109.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
