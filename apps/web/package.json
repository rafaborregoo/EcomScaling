{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env.local -- next dev --port 3001",
    "build": "npm run build -w @ecomscaling/contracts && next build",
    "build:local": "dotenv -e ../../.env.local -- next build",
    "start": "dotenv -e ../../.env.local -- next start --port 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-force-exit src/lib/api-error.test.ts src/portal-state-contract.test.ts src/app/marketing/template-design.test.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ecomscaling/contracts": "^0.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@heroui/react": "^3.2.2",
    "@supabase/supabase-js": "^2.109.0",
    "next": "16.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
