{
  "name": "@ecomscaling/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./shopify-reconcile": {
      "types": "./dist/src/shopify-reconcile.d.ts",
      "default": "./dist/src/shopify-reconcile.js"
    },
    "./operations": {
      "types": "./dist/src/operations.d.ts",
      "default": "./dist/src/operations.js"
    }
  },
  "scripts": {
    "dev": "dotenv -e ../../.env.local -- tsx watch src/server.ts",
    "build": "npm run build -w @ecomscaling/ai -w @ecomscaling/config -w @ecomscaling/contracts -w @ecomscaling/observability && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "dotenv -e ../../.env.local -- tsx --test src/sql-gateway.test.ts src/rls-tenant-isolation.test.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@ecomscaling/ai": "^0.1.0",
    "@ecomscaling/config": "0.1.0",
    "@ecomscaling/contracts": "0.1.0",
    "@ecomscaling/observability": "0.1.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.1.0",
    "@supabase/supabase-js": "^2.109.0",
    "@vercel/node": "^5.8.25",
    "fastify": "^5.6.2",
    "ioredis": "^5.11.1",
    "pgsql-ast-parser": "^12.0.2",
    "ws": "^8.21.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^20.19.17",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}
