{
  "name": "@ecomscaling/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env.local -- tsx watch src/worker.ts",
    "dev:shopify-reconcile": "dotenv -e ../../.env.local -- tsx src/shopify-reconcile-once.ts",
    "dev:alert-rules": "dotenv -e ../../.env.local -- tsx src/alert-rules-once.ts",
    "dev:purge-expired-deletions": "dotenv -e ../../.env.local -- tsx src/purge-expired-deletions-once.ts",
    "dev:shopify-resend-webhooks": "dotenv -e ../../.env.local -- tsx src/shopify-resend-webhooks-once.ts",
    "dev:shopify-reconcile-counts": "dotenv -e ../../.env.local -- tsx src/shopify-reconcile-counts-once.ts",
    "dev:klaviyo-reconcile": "dotenv -e ../../.env.local -- tsx src/klaviyo-reconcile-once.ts",
    "dev:meta-reconcile": "dotenv -e ../../.env.local -- tsx src/meta-reconcile-once.ts",
    "dev:ops-health-check": "dotenv -e ../../.env.local -- tsx src/ops-health-check-once.ts",
    "dev:memory-ingestion": "dotenv -e ../../.env.local -- tsx src/memory-ingestion-once.ts",
    "dev:agent-evals": "dotenv -e ../../.env.local -- tsx src/agent-evals-once.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/worker.js",
    "start:shopify-reconcile": "node dist/shopify-reconcile-once.js",
    "start:alert-rules": "node dist/alert-rules-once.js",
    "start:purge-expired-deletions": "node dist/purge-expired-deletions-once.js",
    "start:shopify-resend-webhooks": "node dist/shopify-resend-webhooks-once.js",
    "start:shopify-reconcile-counts": "node dist/shopify-reconcile-counts-once.js",
    "start:klaviyo-reconcile": "node dist/klaviyo-reconcile-once.js",
    "start:meta-reconcile": "node dist/meta-reconcile-once.js",
    "start:ops-health-check": "node dist/ops-health-check-once.js",
    "start:memory-ingestion": "node dist/memory-ingestion-once.js",
    "start:agent-evals": "node dist/agent-evals-once.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/repeatable-jobs.test.ts src/cron-workflow-env.test.ts src/metrics.test.ts"
  },
  "dependencies": {
    "@ecomscaling/api": "0.1.0",
    "@ecomscaling/config": "0.1.0",
    "@ecomscaling/contracts": "0.1.0",
    "@ecomscaling/observability": "0.1.0",
    "bullmq": "^5.65.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^20.19.17",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}
