# Copia a  deploy/.env.production  EN EL VPS (nunca en git) y rellena valores reales.
# Lo consumen los contenedores api y worker (env_file en docker-compose.prod.yml).
# REDIS_URL lo inyecta compose, no lo pongas aqui.

APP_ENV=production
API_HOST=0.0.0.0
API_PORT=4000

# Dominio de la API (lo usa Caddy para el certificado). dashboard.ecomscaling.es
# / api.ecomscaling.es se retiran, dominio nuevo ecom.noraapp.es. Caddy sacara
# el cert en cuanto exista el DNS A -> 194.164.161.151
API_DOMAIN=api.ecom.noraapp.es

# CORS: dominio exacto de la web (sin barra final).
WEB_ORIGIN=https://ecom.noraapp.es

# Supabase — proyecto "SaaS-EcomScaling" (ref cthjwpeygpzwdmjkxeqa, eu-west-3) --
SUPABASE_URL=https://cthjwpeygpzwdmjkxeqa.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
# Dashboard -> Project Settings -> API Keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=
# Dashboard -> Project Settings -> Database -> Connection string (URI) / password
SUPABASE_DB_URL=postgresql://postgres:PASS@db.cthjwpeygpzwdmjkxeqa.supabase.co:5432/postgres
SUPABASE_DB_PASSWORD=

# Correo transaccional de invitaciones (Brevo SMTP). La API genera el enlace
# con Supabase Auth y lo envía por este canal, sin depender de su límite SMTP.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=b97732001@smtp-brevo.com
SMTP_BREVO=
SMTP_FROM_EMAIL=rafael@noraapp.es
SMTP_FROM_NAME=E-NORA

# Shopify publico (obligatorio aunque no se use todavia). PENDIENTE: app nueva
# en el Partner Dashboard, claves y redirect URI con el dominio nuevo.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,read_inventory,read_locations,read_orders,read_customers,read_discounts,read_marketing_events,read_reports
SHOPIFY_REDIRECT_URI=https://api.ecom.noraapp.es/v1/shopify/oauth/callback
SHOPIFY_API_VERSION=2026-07

# Shopify custom distribution: las 4 juntas o ninguna. Descomenta solo si lo usas.
# SHOPIFY_CUSTOM_API_KEY=
# SHOPIFY_CUSTOM_API_SECRET=
# SHOPIFY_CUSTOM_SCOPES=read_products,read_inventory,read_locations,read_orders,read_customers,read_discounts,read_marketing_events,read_reports
# SHOPIFY_CUSTOM_REDIRECT_URI=https://api.ecom.noraapp.es/v1/shopify/oauth/callback

# Meta Ads: las 3 primeras juntas o ninguna. PENDIENTE: app nueva en Meta for
# Developers, claves nuevas.
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=https://api.ecom.noraapp.es/v1/meta/oauth/callback

# Klaviyo OAuth: las 3 primeras juntas o ninguna. PENDIENTE: app nueva en
# Klaviyo, claves nuevas.
# KLAVIYO_CLIENT_ID=
# KLAVIYO_CLIENT_SECRET=
# KLAVIYO_REDIRECT_URI=https://api.ecom.noraapp.es/v1/klaviyo/oauth/callback

# Que integraciones se activan (coma-separado): shopify,meta,klaviyo,instagram
INTEGRATION_FEATURE_FLAGS=shopify

# Secreto para llamadas internas / cron (genera uno: openssl rand -hex 32)
INTERNAL_API_SECRET=

# URL publica de esta misma API, para el chequeo de SLO del cron.
API_BASE_URL=https://api.ecom.noraapp.es

# IA (opcional; sin claves la plataforma corre con IA desactivada) ------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_API_KEY=
# VOYAGE_API_KEY=
