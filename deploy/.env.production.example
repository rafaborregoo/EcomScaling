# Copia a  deploy/.env.production  EN EL VPS (nunca en git) y rellena valores reales.
# Lo consumen los contenedores api y worker (env_file en docker-compose.prod.yml).
# REDIS_URL lo inyecta compose, no lo pongas aqui.

APP_ENV=production
API_HOST=0.0.0.0
API_PORT=4000

# Dominio de la API (lo usa Caddy para el certificado). Ya puedes dejar el
# valor final: Caddy sacara el cert en cuanto exista el DNS A -> 194.164.161.151
API_DOMAIN=api.ecomscaling.es

# CORS: dominio exacto de la web (sin barra final). De momento la URL .vercel.app;
# cuando conectes el dominio custom en Vercel -> https://dashboard.ecomscaling.es
WEB_ORIGIN=https://TU-APP.vercel.app

# Supabase — proyecto "SaaS-EcomScaling" (ref cthjwpeygpzwdmjkxeqa, eu-west-3) --
SUPABASE_URL=https://cthjwpeygpzwdmjkxeqa.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_tmIeH7SqCCs3FsJ0ub1UrQ_PNDaNaBh
# Dashboard -> Project Settings -> API Keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=
# Dashboard -> Project Settings -> Database -> Connection string (URI) / password
SUPABASE_DB_URL=postgresql://postgres:PASS@db.cthjwpeygpzwdmjkxeqa.supabase.co:5432/postgres
SUPABASE_DB_PASSWORD=

# Shopify publico (obligatorio aunque no se use todavia) ----------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,read_inventory,read_locations,read_orders,read_customers
SHOPIFY_REDIRECT_URI=https://api.ecomscaling.es/v1/shopify/oauth/callback
SHOPIFY_API_VERSION=2026-07

# Shopify custom distribution: las 4 juntas o ninguna. Descomenta solo si lo usas.
# SHOPIFY_CUSTOM_API_KEY=
# SHOPIFY_CUSTOM_API_SECRET=
# SHOPIFY_CUSTOM_SCOPES=read_products,read_inventory,read_locations,read_orders,read_customers
# SHOPIFY_CUSTOM_REDIRECT_URI=https://api.ecomscaling.es/v1/shopify/oauth/callback

# Meta Ads: las 3 primeras juntas o ninguna.
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=https://api.ecomscaling.es/v1/meta/oauth/callback

# Klaviyo OAuth: las 3 primeras juntas o ninguna.
# KLAVIYO_CLIENT_ID=
# KLAVIYO_CLIENT_SECRET=
# KLAVIYO_REDIRECT_URI=https://api.ecomscaling.es/v1/klaviyo/oauth/callback

# Que integraciones se activan (coma-separado): shopify,meta,klaviyo,instagram
INTEGRATION_FEATURE_FLAGS=shopify

# Secreto para llamadas internas / cron (genera uno: openssl rand -hex 32)
INTERNAL_API_SECRET=

# URL publica de esta misma API, para el chequeo de SLO del cron
API_BASE_URL=https://api.ecomscaling.es

# IA (opcional; sin claves la plataforma corre con IA desactivada) ------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_API_KEY=
# VOYAGE_API_KEY=
